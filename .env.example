# Copy this file to .env, set the API keys, and keep .env at mode 600.
# Each job uses model: provider/model-id. The provider selects one group.

# ── go ────────────────────────────────────────────────────────────────
GO_OPENAI_MODEL_ID=mimo-v2.6-flash
GO_ANTHROPIC_MODEL_ID=claude-haiku-5-5
GO_OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
GO_ANTHROPIC_BASE_URL=https://opencode.ai/zen/go
GO_API_KEY=

# ── deepseek ──────────────────────────────────────────────────────────
DEEPSEEK_OPENAI_MODEL_ID=deepseek-flash
DEEPSEEK_ANTHROPIC_MODEL_ID=deepseek-flash
DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=
