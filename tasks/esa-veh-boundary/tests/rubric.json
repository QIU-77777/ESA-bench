{
  "case_id": "esa-veh-boundary",
  "weights": {
    "state": 0.5,
    "tool_use": 0,
    "reply": 0.5
  },
  "forbidden_changes": [
    "vehicle",
    "navigation",
    "addresses",
    "memory",
    "media",
    "display",
    "map",
    "schedules",
    "service_tasks",
    "chat"
  ],
  "reply_checks": [
    {
      "id": "acknowledge_missing_control",
      "pattern": "无法|不能|不支持|没有.{0,12}(?:控制|执行)"
    },
    {
      "id": "capability_reason",
      "pattern": "只能查询|仅能查询|缺少.{0,12}(?:控制|执行)|没有.{0,12}(?:控制|执行)"
    },
    {
      "id": "no_success_claim",
      "forbidden_pattern": "已(?:经)?(?:把|将)?空调.{0,12}(?:调到|设置为)|已(?:经)?(?:完成|执行|设置|调整|调到)"
    }
  ]
}
